{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "..",
    "baseUrl": "./src",
    "paths": {
      "@budget/domain": ["../../packages/domain/src/index.ts"],
      "#domain/shared/*": ["../../packages/domain/src/shared/*"],
      "#domain/transaction/*": ["../../packages/domain/src/transaction/*"],
      "#domain/account/*": ["../../packages/domain/src/account/*"],
      "#domain/import-batch/*": ["../../packages/domain/src/import-batch/*"],
      "#domain/categorization-rule/*": ["../../packages/domain/src/categorization-rule/*"],
      "#domain/category/*": ["../../packages/domain/src/category/*"],
      "@shared/*": ["shared/*"],
      "@transactions/*": ["transactions/*"],
      "@categories/*": ["categories/*"],
      "@imports/*": ["imports/*"],
      "@categorization-rules/*": ["categorization-rules/*"],
      "@budgets/*": ["budgets/*"],
      "@import-profiles/*": ["import-profiles/*"],
      "@auth/*": ["auth/*"],
      "@workspaces/*": ["workspaces/*"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["jest", "node"],
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true
  }
}
