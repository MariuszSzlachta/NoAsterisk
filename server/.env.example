# DEVELOPMENT ONLY. Do not reuse these values in a deployment.

# ─── Database ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=budget
DB_USER=budget_app
DB_PASSWORD=budget_local_development_only
DB_SSL=false

# ─── Persistence mode ──────────────────────────────────────
# 'postgres' = real database | 'memory' = in-memory (dev/tests)
PERSISTENCE_MODE=postgres

# ─── Application ───────────────────────────────────────────
PORT=3000
JWT_SECRET=budget-local-jwt-secret-change-before-deployment
JWT_REFRESH_SECRET=budget-local-refresh-secret-change-before-deployment
CORS_ORIGIN=http://localhost:5173

# 32-byte base64 key used only by the local vault protocol.
VAULT_INFRASTRUCTURE_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
WEBAUTHN_RP_ID=localhost

# ─── Registration ─────────────────────────────────────────
# The local template allows creating the first account without an invite.
# Deployments must make an explicit registration-policy decision.
REGISTRATION_MODE=open

# ─── Seed (development only) ──────────────────────────────
SEED_ADMIN_EMAIL=admin@budget.local
SEED_ADMIN_PASSWORD=budget-local-admin-change-before-deployment
