# ─── Database ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=budget
DB_USER=budget_app
DB_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
DB_SSL=false

# ─── Persistence mode ──────────────────────────────────────
# 'postgres' = real database | 'memory' = in-memory (dev/tests)
PERSISTENCE_MODE=postgres

# ─── Application ───────────────────────────────────────────
PORT=3000
JWT_SECRET=CHANGE_ME_USE_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_USE_DIFFERENT_RANDOM_SECRET
CORS_ORIGIN=http://localhost:5173

# ─── Registration ─────────────────────────────────────────
# 'open' = anyone can register | 'invite-only' = requires valid invite code
REGISTRATION_MODE=invite-only

# ─── Seed (development only) ──────────────────────────────
SEED_ADMIN_EMAIL=admin@budget.local
SEED_ADMIN_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
