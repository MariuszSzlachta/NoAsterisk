{
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "npm run build && node dist/server/src/main",
    "start:dev": "nest start --watch --exec 'node -r ./register-paths.js'",
    "start:pg": "PERSISTENCE_MODE=postgres nest start --watch --exec 'node -r ./register-paths.js'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/shared/infrastructure/database/migrate.ts",
    "db:seed": "tsx src/shared/infrastructure/database/seed.ts",
    "db:seed:dictionaries": "tsx src/dictionaries/infrastructure/seed-dictionaries.ts",
    "db:studio": "drizzle-kit studio",
    "start:debug": "nest start --debug --watch --exec 'node -r ./register-paths.js'",
    "start:prod": "node dist/server/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:strict": "ESLINT_STRICT=true eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@budget/domain": "*",
    "@nestjs/common": "11.1.27",
    "@nestjs/core": "11.1.27",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/throttler": "6.5.0",
    "bcrypt": "6.0.0",
    "dotenv": "16.5.0",
    "drizzle-orm": "0.40.0",
    "helmet": "^8.0.0",
    "pg": "8.13.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "9.39.4",
    "@nestjs/cli": "11.0.23",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.27",
    "@types/bcrypt": "5.0.2",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.2",
    "@types/pg": "8.11.14",
    "@types/supertest": "7.2.0",
    "drizzle-kit": "0.30.4",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.7.0",
    "jest": "30.4.2",
    "prettier": "3.8.4",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.11",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.19.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^@budget/domain$": "<rootDir>/../../packages/domain/src/index.ts",
      "^#domain/shared/(.*)$": "<rootDir>/../../packages/domain/src/shared/$1",
      "^#domain/transaction/(.*)$": "<rootDir>/../../packages/domain/src/transaction/$1",
      "^#domain/account/(.*)$": "<rootDir>/../../packages/domain/src/account/$1",
      "^#domain/import-batch/(.*)$": "<rootDir>/../../packages/domain/src/import-batch/$1",
      "^#domain/categorization-rule/(.*)$": "<rootDir>/../../packages/domain/src/categorization-rule/$1",
      "^#domain/category/(.*)$": "<rootDir>/../../packages/domain/src/category/$1",
      "^#domain/budget/(.*)$": "<rootDir>/../../packages/domain/src/budget/$1",
      "^@shared/(.*)$": "<rootDir>/shared/$1",
      "^@transactions/(.*)$": "<rootDir>/transactions/$1",
      "^@categories/(.*)$": "<rootDir>/categories/$1",
      "^@imports/(.*)$": "<rootDir>/imports/$1",
      "^@categorization-rules/(.*)$": "<rootDir>/categorization-rules/$1",
      "^@auth/(.*)$": "<rootDir>/auth/$1",
      "^@workspaces/(.*)$": "<rootDir>/workspaces/$1",
      "^@import-profiles/(.*)$": "<rootDir>/import-profiles/$1",
      "^@user-settings/(.*)$": "<rootDir>/user-settings/$1",
      "^@dictionaries/(.*)$": "<rootDir>/dictionaries/$1",
      "^@invite-codes/(.*)$": "<rootDir>/invite-codes/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
