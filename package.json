{
  "name": "budget",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "packages/*"
  ],
  "overrides": {
    "@nestjs/platform-express@11.2.1": {
      "multer": "$multer"
    },
    "body-parser": {
      "qs": "6.16.0"
    },
    "express": {
      "qs": "6.16.0"
    },
    "multer": "2.3.0",
    "qs": "6.16.0"
  },
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "storybook": "npm run storybook --workspace=client",
    "prepare": "husky"
  },
  "lint-staged": {
    "server/**/*.ts": [
      "bash -c 'cd server && ESLINT_STRICT=true npx eslint --fix \"$@\"' --",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.0.8"
  }
}
