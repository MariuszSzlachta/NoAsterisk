{
  "singleQuote": true,
  "trailingComma": "all",
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder": [
    "^react",
    "<THIRD_PARTY_MODULES>",
    "",
    "^#app/(.*)$",
    "^#pages/(.*)$",
    "^#features/(.*)$",
    "^#entities/(.*)$",
    "^#shared/(.*)$",
    "",
    "^[./]"
  ],
  "importOrderTypeScriptVersion": "6.0.0"
}
