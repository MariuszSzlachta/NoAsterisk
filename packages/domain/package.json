{
  "name": "@budget/domain",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "imports": {
    "#domain/shared/*": "./src/shared/*.ts",
    "#domain/transaction/*": "./src/transaction/*.ts",
    "#domain/account/*": "./src/account/*.ts",
    "#domain/categorization-rule/*": "./src/categorization-rule/*.ts",
